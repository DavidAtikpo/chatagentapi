# Supabase — URL API (https://xxx.supabase.co), PAS l'URL postgres postgresql://...
SUPABASE_URL=https://gvasbtkswyisogoasutl.supabase.co
SUPABASE_SERVICE_KEY=
# JWT Secret (Supabase → Project Settings → API → JWT Secret) — requis pour l'app mobile agent
SUPABASE_JWT_SECRET=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI (embeddings)
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Cloud Messaging (push handoff → app mobile)
# Option A (local) : télécharger la clé Firebase et la placer ici :
#   api/firebase-service-account.json
# Option B (Render) : coller le JSON sur une seule ligne :
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option C : chemin personnalisé vers le fichier JSON
# FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# WhatsApp Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# App — CORS dynamique (voir app/services/cors_origins.py)
# CORS_ORIGINS : origines fixes en plus des sites clients (dashboard Vercel, etc.)
# Mettre * désactive le filtrage (dev uniquement)
CORS_ORIGINS=https://chatagentcides.qrthecode2.com
APP_URL=http://localhost:3000
API_URL=http://localhost:8000/api/v1
WIDGET_CDN_URL=http://localhost:8787/widget.js
DEBUG=true
