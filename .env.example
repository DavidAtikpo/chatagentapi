# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Migration one-shot Supabase → Neon (scripts/migrate_supabase_to_neon.py)
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[pwd]@db.[ref].supabase.co:5432/postgres

# OCR PDF scannés (Tesseract requis — inclus dans le Dockerfile API)
OCR_ENABLED=true
OCR_LANGUAGES=fra+eng
OCR_RENDER_SCALE=2.0

# Cloudinary (optionnel côté API — uploads faits surtout par le web Next.js)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Même secret que web (AUTH_SECRET) — JWT login dashboard + app mobile agent
AUTH_SECRET=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Facturation / checkout : Next.js (chatagent/.env.local) — webhook https://votre-app.com/api/webhooks/stripe

# Préférer le fichier (gitignored) — évite les erreurs python-dotenv sur JSON multiligne
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
# Ou une seule ligne : FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000/api/v1
WIDGET_CDN_URL=http://localhost:8787/widget.js
DEBUG=true
